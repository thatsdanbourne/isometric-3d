; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="isometric 3d"
run/main_scene="uid://dtgd4yjkf4awx"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/managers/GameManager.cs"
CraftingManager="*res://scripts/managers/CraftingManager.cs"
InventoryManager="*res://scripts/managers/InventoryManager.cs"
AudioManager="*res://scripts/managers/AudioManager.cs"
SettingsManager="*res://scripts/managers/SettingsManager.cs"
Init="*res://scripts/systems/Init.cs"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=2304
window/size/viewport_height=1296
window/size/initial_position_type=0
window/size/initial_position=Vector2i(1500, 500)
window/defaults/default_clear_color=Color(0.106236584, 0.106236584, 0.106236555, 1)

[dotnet]

project/assembly_name="isometric 3d"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/collapse_folders/plugin.cfg")

